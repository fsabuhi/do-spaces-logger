DOMAIN=spaces-logs.example.com
ADMIN_USER=admin
# Generate with: docker run --rm -i caddy:2.10-alpine caddy hash-password
# Keep the generated hash in single quotes so Compose preserves its $ characters.
ADMIN_PASSWORD_HASH='$2a$14$replace_with_a_caddy_bcrypt_hash'

APP_CONFIG=/app/config.toml
DATABASE_PATH=/data/spaces.db
APP_TIMEZONE=Asia/Baku
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
# Local alternative to the two variables above (for example: do-tor1).
# Docker deployments should use the explicit variables instead.
AWS_PROFILE=
DIGITALOCEAN_TOKEN=
SLACK_WEBHOOK_URL=
